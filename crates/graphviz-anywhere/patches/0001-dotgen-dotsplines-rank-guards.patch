+/* y coordinate of the first node on rank r, when the rank holds one.
+ *
+ * Ranks can be empty: `minlen=0` edges combined with rank constraints
+ * compress the ranking, and a self edge, a flat edge or rank_box() would then
+ * dereference a null v[0]. Callers fall back to their default spacing. */
+static bool rank_first_y(graph_t *g, int r, double *y) {
+  if (r < GD_minrank(g) || r > GD_maxrank(g))
+    return false;
+  node_t *const first = GD_rank(g)[r].v[0];
+  if (first == NULL)
+    return false;
+  *y = ND_coord(first).y;
+  return true;
+}
 
