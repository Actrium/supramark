{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supramark.dev/schemas/markdown-conformance-case-v1.json",
  "title": "Supramark Markdown conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "profile",
    "input",
    "expected",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "version",
        "path",
        "revision",
        "upstreamId",
        "section",
        "startLine",
        "endLine"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "upstreamId": {
          "type": [
            "integer",
            "string"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "commonmark",
        "gfm",
        "supramark"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown"
      ],
      "properties": {
        "markdown": {
          "type": "string"
        },
        "upstreamOptions": {
          "type": "object"
        },
        "upstreamEncoding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "html",
        "semanticTypes",
        "comparison"
      ],
      "properties": {
        "kind": {
          "enum": [
            "normative",
            "implementation"
          ]
        },
        "html": {
          "type": "string"
        },
        "comparison": {
          "enum": [
            "semantic-html",
            "exact-html"
          ]
        },
        "semanticTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureIds",
        "syntax",
        "candidateNodeTypes",
        "renderers"
      ],
      "properties": {
        "featureIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@supramark/feature-"
          }
        },
        "syntax": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "renderers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "web",
              "react-native"
            ]
          }
        },
        "candidateNodeTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
