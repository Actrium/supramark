+static bool needsSelectionMetrics(const facebook::react::ParagraphProps &props) {
+  return props.onTextLayout && props.nativeId.rfind("supramark-selection-", 0) == 0;
+}
+
+// Geometry of the same DirectWrite layout used to draw the paragraph, in DIPs.
+static folly::dynamic selectionLines(
+    IDWriteTextLayout &layout,
+    std::wstring_view text,
+    facebook::react::EdgeInsets const &insets) {
+  UINT32 count = 0;
+  DWRITE_TEXT_METRICS metrics{};
+  winrt::check_hresult(layout.GetMetrics(&metrics));
+  count = metrics.lineCount;
+  std::vector<DWRITE_LINE_METRICS> lines(count);
+  winrt::check_hresult(layout.GetLineMetrics(lines.data(), count, &count));
+  auto result = folly::dynamic::array();
+  UINT32 start = 0;
+  float top = metrics.top + insets.top;
+  for (const auto &line : lines) {
+    auto edges = folly::dynamic::array();
+    const UINT32 visible = line.length - line.newlineLength;
+    float left = 0;
+    float right = 0;
+    for (UINT32 i = 0; i <= visible; ++i) {
+      // At a soft wrap, use the trailing edge of this line's last cluster.
+      const bool trailing = i == visible && i > 0;
+      float x = 0;
+      float y = 0;
+      DWRITE_HIT_TEST_METRICS hit{};
+      winrt::check_hresult(layout.HitTestTextPosition(start + i - (trailing ? 1 : 0), trailing, &x, &y, &hit));
+      x += insets.left;
+      left = i == 0 ? x : std::min(left, x);
+      right = i == 0 ? x : std::max(right, x);
+      edges.push_back(x);
+    }
+    result.push_back(folly::dynamic::object("text", winrt::to_string(text.substr(start, line.length)))
+        ("x", left)("y", top)("width", right - left)("height", line.height)("charXs", std::move(edges)));
+    start += line.length;
+    top += line.height;
+  }
+  return result;
+}
