{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // `node` is here because the workspace `@supramark/*` packages resolve to
    // their `src/`, so this config also checks that code — and
    // `packages/renderers/web` references `process`.
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Monorepo paths */
    "baseUrl": "../../",
    "paths": {
      "@supramark/core": ["packages/core/src"],
      "@supramark/web": ["packages/renderers/web/src"],
      "@supramark/feature-weather": ["packages/features/container/feature-weather/src"]
    }
  },
  "include": ["src"],
  // Tests import `bun:test`, and this workspace does not install its types.
  // Other packages exclude their test dirs from `tsc` the same way.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
